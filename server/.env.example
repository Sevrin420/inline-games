# inline-games API configuration. Production values shown; nothing here is secret.
# On the VPS this lives at /etc/inline-games-api.env (deploy-api.yml creates it
# from this file ONLY if it doesn't exist, and never overwrites it).

PORT=3100
HOST=127.0.0.1
DB_PATH=/var/lib/inline-games-api/inline-games.sqlite

# The site players use. POSTs must come from one of ALLOWED_ORIGINS (same-origin check).
PUBLIC_ORIGIN=https://membersonly.cc
# ALLOWED_ORIGINS=https://membersonly.cc,https://www.membersonly.cc

# Sign-In with Ethereum: the domain must match the page the wallet sees.
# SIWE_CHAIN_ID is the "login chain" in the message (not the NFT gate chain).
SIWE_DOMAIN=membersonly.cc
SIWE_CHAIN_ID=1

# Session/anon cookies: HttpOnly; Secure; SameSite=Lax; Domain=.membersonly.cc
# Set COOKIE_DOMAIN= (empty) for a host-only cookie.
COOKIE_DOMAIN=.membersonly.cc
COOKIE_SECURE=true

# Caddy runs on the same box; trust X-Forwarded-For only from it.
TRUST_PROXY=127.0.0.1

# Plays left open longer than this are closed with no outcome.
STALE_PLAY_HOURS=24

# ---- NFT gate (only needed once a game in server/games.json uses access "nft").
# Leave blank until the gate chain/collection is decided. While blank, nft-level
# games answer 503 gate_unconfigured and /auth/me reports nftStatus "unconfigured".
# NFT_GATE_RPC_URL may contain a provider API key: keep this file root:inline-games 0640.
NFT_GATE_CHAIN_ID=
NFT_GATE_RPC_URL=
NFT_GATE_CONTRACT=
NFT_GATE_MIN_BALANCE=1
NFT_GATE_CACHE_SECONDS=45

# Admin token for leaderboard moderation (remove a bad name). deploy-api.yml
# generates a random one in /etc/inline-games-api.env if it's missing; it is
# never printed. Unset or shorter than 24 characters = admin endpoints disabled.
# ADMIN_TOKEN=

# Local development only (serve games/ from the API on one port):
# DEV_STATIC_DIR=../games
# LOG_LEVEL=info
